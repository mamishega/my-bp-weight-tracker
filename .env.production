# Public build settings (not secrets: both addresses are visible in the built site).
# Doctor-share relay (share-worker/). Remove to build without sharing.
VITE_SHARE_API_URL=https://bp-tracker-share.mohammedsherif07.workers.dev
# Doctor links start with this neutral address instead of the GitHub Pages one
# (which contains the GitHub account name). It must serve this same app.
VITE_SHARE_LINK_BASE=https://my-bp-weight-tracker.pages.dev/
